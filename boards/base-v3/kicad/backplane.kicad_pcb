	(title_block
		(title "MacPro6,2 Backplane (BP) rev A1 'BP-G4' - routed, 4 layers")
		(date "2026-10-04")
		(rev "A1")
		(company "MacPro6,2 / Aidan Winkler")
		(comment 1 "Stackup JLC04161H-7628 4L 1.6 mm: L1 RX pairs + parts (85R: 0.26/0.125), L2 GND, L3 TX pairs + power (85R: 0.21/0.127, ref L4), L4 GND + short RX breakouts")
		(comment 2 "Gen4 only (redrivers removed, loss budget in README). FS lanes per ICD rev 3.1 proposal (reversed on CPU-LINK)")
		(comment 3 "MCU RP2350B, INA226, 2x TPS563201 (3V3_SB 3 A merged rail, 5V_SBY), HW PS_ON gate + thermal latch")
		(comment 4 "Interface connector positions = fp6 / ICD rev 3 (J1, J2, J3, J4, J6, J9, J10, H1, H2)")
	)
